{
  "name": "game-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "tsc -b && pnpm -r --if-present bundle",
    "clean": "tsc -b --clean",
    "check:deps": "node scripts/check-deps.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "pnpm check:deps && pnpm check:links && pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:playable": "pnpm build && node packages/demo/probe/playable-smoke.mjs",
    "test:mechanic": "pnpm build && node packages/demo/probe/mechanic-probe.mjs",
    "test:acceptance": "pnpm build && node packages/demo/probe/free-acceptance.mjs",
    "typecheck": "tsc -b && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:"
  }
}
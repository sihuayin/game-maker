{
  "name": "game-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "pnpm check:deps && pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
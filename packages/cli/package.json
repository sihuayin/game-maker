{
  "name": "@game-maker/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CLI \u8584\u58f3\u3002",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@game-maker/contracts": "workspace:*",
    "@game-maker/assets": "workspace:*",
    "@game-maker/demo": "workspace:*"
  },
  "bin": {
    "game-maker": "./dist/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --external:vite --external:phaser",
    "typecheck": "tsc -p tsconfig.spec.json"
  }
}